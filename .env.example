# Copy this file to .env and fill in your real key
# .env is gitignored — never commit your real key

# Optional: enables live Claude-written AI briefings. Without it, briefings
# fall back to deterministic text generated from the same data.
ANTHROPIC_API_KEY=sk-ant-paste-your-hackathon-key-here

# Optional: path to the hackathon data bundle (defaults to ./hackathon_data_bundle)
DATA_BUNDLE_PATH=./hackathon_data_bundle

# Optional: port for the Flask cockpit app (defaults to 5000)
PORT=5000
